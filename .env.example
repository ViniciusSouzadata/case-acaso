# Copie para .env (ignorado pelo git). Nenhuma credencial real aqui: valores de desenvolvimento local.
POSTGRES_DB=acaso
POSTGRES_USER=loader_rw
POSTGRES_PASSWORD=acaso_dev
# Porta do Postgres no host (5433 para nao colidir com outro Postgres local)
POSTGRES_HOST_PORT=5433
