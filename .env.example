# Copie para .env (ignorado pelo git). Nenhuma credencial real aqui: valores de desenvolvimento local.
POSTGRES_DB=acaso
POSTGRES_USER=loader_rw
POSTGRES_PASSWORD=acaso_dev
# Porta do Postgres no host (5433 para nao colidir com outro Postgres local)
POSTGRES_HOST_PORT=5433
# Senha do papel app_ro (leitura apenas em mart/resultado), aplicada pelo executor de migracoes
APP_RO_PASSWORD=acaso_ro_dev

# Classificador LLM (valores só no .env, que o git ignora; nunca no chat nem no repositório)
OPENROUTER_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
LLM_TETO_USD=3.00
